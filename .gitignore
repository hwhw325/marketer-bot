# 환경 변수
.env
.env.local
.env.*.local

# Next.js 빌드 캐시 무시
.next/
node_modules

/lib/generated/prisma

# ---- ENV (값 있는 파일은 전부 무시, 템플릿만 허용) ----
.env*
!.env.example            # ← 값 비어있는 템플릿만 커밋 허용

# ---- Logs / dumps ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
dump*.sql

# ---- System / tools ----
.DS_Store
.vercel
.turbo

# ---- Next.js / build ----
out/
dist/
.next/cache/

# ---- Prisma (db 파일은 무시, migrations는 커밋) ----
*.db
*.db-journal
prisma/*.db
prisma/*.db-journal
# prisma/migrations/**  (커밋해야 함! ignore 금지)

# ---- Coverage / test ----
coverage/

# ---- Local editor ----
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
