# ───────────────── Env (비밀 커밋 금지: 템플릿만 허용) ─────────────────
.env
.env.local
.env.*.local
!.env.example

# ───────────────── Node / Next / Vercel 산출물 ─────────────────
node_modules/
.next/
.next/cache/
out/
dist/
.vercel/
.turbo/

# ───────────────── Logs / dumps ─────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
dump*.sql

# ───────────────── System / Editor ─────────────────
.DS_Store
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# ───────────────── Prisma ─────────────────
# 스키마/마이그레이션은 반드시 커밋. 로컬 DB 파일만 무시.
*.db
*.db-journal
prisma/*.db
prisma/*.db-journal
!prisma/schema.prisma
!prisma/migrations/**

# ───────────────── Coverage / Tests ─────────────────
coverage/

# ───────────────── Generated code (옵션) ─────────────────
/lib/generated/prisma/
