# === App base (Production만 설정 권장) ===
NEXTAUTH_URL=                 # ex) https://copyquick.co.kr  (Preview엔 비우기)
NEXT_PUBLIC_SITE_URL=         # ex) https://copyquick.co.kr  (클라이언트 노출, Prod만)

# === Auth / Providers ===
NEXTAUTH_SECRET=              # openssl rand -base64 32

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# === Email (NextAuth Magic Link) ===
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=465         # 465:true / 587:false
EMAIL_SERVER_SECURE=true
EMAIL_SERVER_AUTH_USER=
EMAIL_SERVER_AUTH_PASSWORD=
EMAIL_FROM=                   # ex) "CopyQuick <no-reply@your-domain>"

# (선택) 이메일 재요청 쿨다운(ms)
EMAIL_RATE_LIMIT_MS=30000

# === OpenAI ===
OPENAI_API_KEY=

# === Database (예시만, 실제 값은 Vercel Env/로컬 .env에) ===
# SQLite (local dev)
# DATABASE_URL="file:./prisma/dev.db"

# PostgreSQL (prod/dev 예시: Neon pooler/pgbouncer 권장)
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?schema=public&pgbouncer=true&sslmode=require"

# === App config (선택) ===
DEFAULT_PLAN=free
NEXT_PUBLIC_ASSET_VERSION=1

# === Payments (아직 미사용이면 주석 유지) ===
# TOSS_SECRET_KEY=
# NEXT_PUBLIC_TOSS_CLIENT_KEY=
# WEBHOOK_SECRET_TOSS=
