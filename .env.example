# ================================
# CopyQuick .env.example (TEMPLATE)
# 실값 금지 — 이 파일은 레포에 커밋용
# ================================

# === Base URLs (Production만 설정 권장) ===
# Preview는 자동 도메인(VERCEL_URL) 쓰도록 비워두세요.
NEXTAUTH_URL=                 # ex) https://copyquick.co.kr   (Prod 전용)
NEXT_PUBLIC_SITE_URL=         # ex) https://copyquick.co.kr   (Prod 전용, 클라이언트에 노출)

APP_BRAND_NAME=CopyQuick      # 선택. 없으면 코드에서 "CopyQuick"로 폴백

# === Auth / Providers ===
NEXTAUTH_SECRET=              # openssl rand -base64 32

# GitHub OAuth (표준 키명)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# (호환용 레거시 키 — 채우지 않아도 코드에서 폴백 지원)
# GITHUB_ID=
# GITHUB_SECRET=

# === Email (NextAuth Magic Link / SMTP) ===
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=465         # 465:true / 587:false
EMAIL_SERVER_SECURE=true
# 표준 키명(권장)
EMAIL_SERVER_AUTH_USER=
EMAIL_SERVER_AUTH_PASSWORD=
# (호환용 레거시 키 — 채우지 않아도 코드에서 폴백 지원)
# EMAIL_SERVER_USER=
# EMAIL_SERVER_PASS=
EMAIL_FROM=                   # ex) "CopyQuick <no-reply@your-domain>"
EMAIL_RATE_LIMIT_MS=30000     # 선택: 동일 이메일 재요청 쿨다운(ms)

# === OpenAI ===
OPENAI_API_KEY=

# === Database (예시만 — 실제 값은 Vercel/로컬 .env에만) ===
# SQLite (local dev) 예시
# DATABASE_URL="file:./prisma/dev.db"

# Postgres (Neon 등 — pooler/SSL 권장) 예시
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?schema=public&pgbouncer=true&sslmode=require"

# === App config (선택) ===
DEFAULT_PLAN=free
NEXT_PUBLIC_ASSET_VERSION=1

# === Feedback/문의 메일러(별도 SMTP) ===
# 사이트 내 '문의하기' 등에서 사용
MAIL_HOST=
MAIL_PORT=
MAIL_SECURE=
MAIL_USER=
MAIL_PASS=
MAIL_TO=                     # 수신자(운영팀 메일)

# === Payments (토스 결제: 아직 미사용이면 주석 유지) ===
# TOSS_SECRET_KEY=
# NEXT_PUBLIC_TOSS_CLIENT_KEY=
# WEBHOOK_SECRET_TOSS=

# === Dev/진단 옵션(선택) ===
# PRISMA_LOG_QUERIES=true     # SQL 로그 출력(개발 중에만 권장)
# PORT=3001                   # 로컬 포트 고정이 필요할 때만
